<?xml version="1.0" encoding="utf-8"?>
<!-- __APP_ID__ é trocado pelo identificador em android/app.conf na hora de gerar o APK -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="__APP_ID__">

    <!-- Atualizar o conteúdo, login e nuvem -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Tema"
        android:allowBackup="true"
        android:supportsRtl="false">
        <activity
            android:name="com.gabrielfbrandao.siteapp.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Volta do login: o navegador abre __APP_ID__://login?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="__APP_ID__" android:host="login" />
            </intent-filter>
        </activity>
        <provider
            android:name="com.gabrielfbrandao.siteapp.Arquivos"
            android:authorities="__APP_ID__.arquivos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

    <!-- Android 11+: deixa ver se há app de câmera -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
